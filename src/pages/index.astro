---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import {
  META, GDP_2025, GROWTH_2026, INFLATION_2026, COMPARISON, RECONSTRUCTION,
  SCENARIOS, CONCLUSIONS, FAQ, NUANCES, LIMITATIONS, SOURCES,
} from '../data/data.js';

const toneMap = {
  teal: 'text-col-blue-bright',
  amber: 'text-col-amber-deep',
  rose: 'text-col-red',
};
const venMax = Math.max(...GROWTH_2026.map((g) => g.ven ?? 0));
const infMax = Math.max(...INFLATION_2026.map((i) => i.value));
const barW = (v, max) => `${Math.max(1.5, (v / max) * 100)}%`;
const GROWTH_ROWS = GROWTH_2026.map((g) => ({ ...g, label: g.col !== null ? g.org + ' · CO' : g.org }));
---

<Layout>
  {/* ===================== HERO ===================== */}
  <section id="inicio" class="relative overflow-hidden">
    <div class="mx-auto max-w-6xl px-4 pb-14 pt-16 text-center sm:pt-24">
      <span class="badge mb-4">Guía paso a paso · Datos fechados y con fuente</span>
      <h1 class="mx-auto max-w-4xl text-3xl font-black leading-tight tracking-tight text-slate-900 sm:text-5xl">
        ¿Cuántos años tardaría Venezuela en alcanzar el{' '}
        <span class="bg-gradient-to-r from-col-amber-deep to-col-blue bg-clip-text text-transparent">nivel de vida de Colombia</span>?
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base">
        Actualizado al {META.updated}. Los datos están fechados y con fuente; lo que es proyección o supuesto propio está marcado como tal.
        Aquí no se opina sobre gobiernos ni candidatos.
      </p>

      <div class="card mx-auto mt-8 max-w-3xl border-col-amber-soft bg-col-amber-mist text-left">
        <p class="text-sm leading-relaxed text-slate-700">
          <span class="font-bold text-col-amber-deep">La idea central:</span> que el PIB de Venezuela crezca rápido no equivale a que el país esté reconstruido.
          Rebotar tras un colapso es más fácil que reconstruir instituciones, electricidad, escuelas y confianza.
          Por eso el modelo tiene una <span class="font-semibold text-slate-900">“perilla de fricción institucional”</span>.
        </p>
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3 text-xs font-medium">
        <a href="#modelo" class="usa-button usa-button--primary !bg-col-blue !shadow-none hover:!bg-col-blue-bright !font-bold">Ir al simulador →</a>
        <a href="#respuesta" class="usa-button usa-button--outline !border-slate-300 !text-slate-900 !font-bold hover:!bg-slate-50">Ver la respuesta directa</a>
      </div>
    </div>
  </section>

  {/* ===================== PASO 1 ===================== */}
  <Section step="1" id="punto-partida" title="El punto de partida: dos países en momentos distintos">
    {/* Alerta USWDS: idea central del paso */}
    <div class="usa-alert usa-alert--info margin-bottom-4">
      <div class="usa-alert__body">
        <h3 class="usa-alert__heading text-sm font-bold uppercase tracking-wide">Idea clave del paso</h3>
        <p class="usa-alert__text text-sm leading-relaxed">
          Colombia parte con una ventaja de <strong>2,4× en PIB por persona</strong>. Toda la simulación posterior mide cuánto tarda Venezuela en cerrar esa brecha.
        </p>
      </div>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {GDP_2025.map((c) => (
        <div class="card">
          <p class="text-xs font-medium uppercase tracking-wide text-slate-600">{c.label}</p>
          <p class={`mt-2 text-3xl font-black ${toneMap[c.tone]}`}>{c.value}</p>
          <p class="mt-2 text-xs text-slate-600">Fuente: {c.source}</p>
          <p class="mt-1 text-[11px] italic text-slate-500">{c.note}</p>
        </div>
      ))}
    </div>
    {/* Alerta USWDS "warning": reemplaza el callout previo */}
    <div class="usa-alert usa-alert--warning margin-top-4">
      <div class="usa-alert__body">
        <p class="usa-alert__text text-xs leading-relaxed">
          <strong>Advertencia:</strong> en Venezuela el tipo de cambio y la población son inciertos, así que la cifra nominal en dólares es un orden de magnitud, no un dato exacto. Aún falta el dato en PPA (poder adquisitivo) con fuente verificable.
        </p>
      </div>
    </div>
  </Section>

  {/* ===================== PASO 2 ===================== */}
  <Section step="2" id="crecimiento" title="Quién crece más… y cuánto se sabe realmente">
    <p class="mb-6 max-w-3xl text-sm leading-relaxed text-slate-600">
      Venezuela proyecta crecer mucho más que Colombia en 2026, pero las fuentes discrepan: de 4% (FMI, abril) a más de 10% (UCAB, Ecoanalítica).
      <span class="font-semibold text-slate-800">Esa dispersión es en sí misma una señal de poca información fiable.</span>
    </p>

    <div class="grid gap-4 lg:grid-cols-2">
      <div class="card">
        <h3 class="mb-1 text-sm font-bold text-slate-900">Crecimiento del PIB 2026 (%) según fuente</h3>
        <p class="mb-4 text-[11px] text-slate-500"><span class="text-col-amber-deep">■</span> Venezuela &nbsp; <span class="text-col-blue-bright">■</span> Colombia</p>
        <div class="space-y-2.5">
          {GROWTH_ROWS.map((g) => (
            <div class="flex items-center gap-3 text-xs">
              <span class="w-40 shrink-0 text-right text-slate-600">{g.label}</span>
              <div class="h-5 flex-1 overflow-hidden rounded-md bg-slate-100">
                <div
                  class={['flex h-full items-center justify-end rounded-md px-1.5 font-bold text-slate-900', g.col !== null ? 'bg-col-blue-bright' : 'bg-col-amber'].join(' ')}
                  style={{ width: barW(g.col ?? g.ven, venMax) }}
                >
                  {(g.col ?? g.ven).toLocaleString('es-ES')}%{g.venNote ? ` (${g.venNote})` : ''}
                </div>
              </div>
            </div>
          ); })}
        </div>
        <p class="mt-4 text-[11px] leading-relaxed text-slate-500">Rango Venezuela: 4,0%–11% · Rango Colombia: 2,2%–2,6%. Se grafica Ecoanalítica con 11 (rango 10–12).</p>
      </div>

      <div class="card">
        <h3 class="mb-1 text-sm font-bold text-slate-900">…y el precio de crecer: inflación 2026 (%)</h3>
        <p class="mb-4 text-[11px] text-slate-500">Escala lineal sobre el máximo (≈468%)</p>
        <div class="space-y-2.5">
          {INFLATION_2026.map((i) => (
            <div class="flex items-center gap-3 text-xs">
              <span class="w-40 shrink-0 text-right text-slate-600">{i.org} · {i.country}</span>
              <div class="h-5 flex-1 overflow-hidden rounded-md bg-slate-100">
                <div
                  class={["flex h-full items-center justify-end rounded-md px-1.5 font-bold text-slate-900", i.country === 'Colombia' ? 'bg-col-blue-bright' : 'bg-col-red'].join(' ')}
                  style={{ width: barW(i.value, infMax) }}
                >
                  ≈{i.value}%
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="usa-alert usa-alert--error margin-top-4 !py-2">
          <div class="usa-alert__body">
            <p class="usa-alert__text text-[11px] leading-relaxed">
              Con inflación así, el crecimiento medido <strong>no se traduce en poder de compra</strong> para el hogar promedio.
            </p>
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* ===================== PASO 3 ===================== */}
  <Section step="3" id="cara-a-cara" title="Comparación cara a cara">
    {/* Etiqueta USWDS: los datos están fechados y con fuente */}
    <ul class="usa-tag-group display-flex flex-wrap gap-1 margin-bottom-4 list-none padding-0">
      <li><span class="usa-tag bg-col-blue-bright">Datos abril–octubre 2026</span></li>
      <li><span class="usa-tag bg-col-amber-deep">Proyecciones marcadas como tales</span></li>
      <li><span class="usa-tag bg-base-dark">Sin opinión política</span></li>
    </ul>
    <div class="card overflow-x-auto !p-0">
      <table class="w-full min-w-[720px] border-collapse text-left text-xs sm:text-[13px]">
        <caption class="sr-only">Comparación de indicadores entre Colombia y Venezuela, 2025–2026</caption>
        <thead>
          <tr class="border-b border-slate-200 bg-slate-50 text-slate-900">
            <th class="px-4 py-3 font-bold">Indicador</th>
            <th class="px-4 py-3 font-bold"><span class="mr-1.5 inline-block h-2.5 w-2.5 rounded-full bg-col-blue-bright"></span>Colombia</th>
            <th class="px-4 py-3 font-bold"><span class="mr-1.5 inline-block h-2.5 w-2.5 rounded-full bg-col-amber"></span>Venezuela</th>
          </tr>
        </thead>
        <tbody>
          {COMPARISON.map((r, idx) => (
            <tr class={`border-b border-slate-100 align-top transition hover:bg-slate-100 ${idx % 2 ? 'bg-slate-50/70' : ''}`}>
              <td class="px-4 py-3 font-semibold text-slate-800">{r.indicator}</td>
              <td class="px-4 py-3 leading-relaxed text-slate-600">{r.col || '—'}</td>
              <td class="px-4 py-3 leading-relaxed text-slate-600">{r.ven || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Section>

  {/* ===================== PASO 4 ===================== */}
  <Section step="4" id="reconstruccion" title="Lo que el PIB no mide: el país que hay que reconstruir">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {RECONSTRUCTION.map((k) => (
        <div class="card text-center transition hover:-translate-y-0.5 hover:border-col-amber-soft">
          <p class="bg-gradient-to-br from-col-amber-deep to-col-red bg-clip-text text-4xl font-black text-transparent">{k.value}</p>
          <p class="mt-2 text-xs font-medium leading-snug text-slate-700">{k.label}</p>
          <p class="mt-1 text-[11px] text-slate-500">{k.note}</p>
        </div>
      ))}
    </div>
    <div class="usa-alert usa-alert--info margin-top-4">
      <div class="usa-alert__body">
        <p class="usa-alert__text text-sm leading-relaxed text-slate-700">
          Crecer 7% tras caer 80% es recuperar terreno, no igualar a nadie. Reconstruir la red eléctrica, el sistema escolar, el sistema de salud,
          la confianza de inversionistas y el estado de derecho <strong class="text-slate-900">toma décadas y no sale en ninguna tasa de crecimiento</strong>.
          Ningún modelo de abajo lo captura por completo.
        </p>
      </div>
    </div>

    {/* Gráfico de barras USWDS: magnitudes del país que hay que reconstruir */}
    <div class="margin-top-6">
      <h3 class="font-caption font-body-lg text-base-dark margin-bottom-2">Indicadores sociales ENCOVI 2025 (Venezuela)</h3>
      <ul class="ven-graph list-none padding-0 margin-0">
        {RECONSTRUCTION.map((k) => (
          <li class="margin-bottom-105">
            <div class="display-flex flex-align-center gap-2">
              <span class="ven-label w-14 shrink-0 font-body-xs text-bold text-center">{k.value}</span>
              <div class="height-2 flex-fill rounded-md overflow-hidden bg-col-red-mist ring-1 ring-col-red-soft">
                <div class="h-full rounded-md bg-gradient-to-r from-col-red to-col-red/70" style=`width:${(parseFloat(k.value.replace(',', '.')) / 68.5) * 100}%`}></div>
              </div>
            </div>
            <p class="margin-top-05 font-body-xs text-gray-cool-70 leading-snug">{k.label} <span class="text-gray-cool-50">· {k.note}</span></p>
          </li>
        ))}
      </ul>
      <p class="font-body-3xs text-gray-cool-50 margin-top-1">Escala común: magnitud relativa al mayor indicador de hogares (68,5%, pobreza ENCOVI). El dato de «1,2 M» corresponde a personas fuera del sistema educativo; solo 64% de 3 a 24 años está escolarizado.</p>
    </div>
  </Section>

  {/* ===================== PASO 5: SIMULADOR ===================== */}
  <Section step="5" id="modelo" title="El modelo: ¿cuántos años hasta alcanzar a Colombia?">
    <p class="mb-6 max-w-3xl text-sm leading-relaxed text-slate-600">
      Se simulan <strong class="text-slate-800">5.000 trayectorias por escenario</strong>. Cada año, Venezuela y Colombia crecen con un valor aleatorio alrededor de un promedio.
      Se cuenta cuándo Venezuela alcanza el PIB por persona de Colombia (brecha inicial 2,4×).
      <span class="badge ml-1 border-col-amber-soft text-col-amber-deep">Supuestos propios, no datos</span>
    </p>

    <div class="grid gap-4 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <div class="grid gap-3 sm:grid-cols-2">
          {SCENARIOS.map((s) => (
            <button data-scenario={s.id} class="scenario-card card group cursor-pointer text-left transition hover:border-slate-300">
              <div class="flex items-start justify-between gap-2">
                <h3 class="text-sm font-bold text-slate-900">{s.name}</h3>
                <span class="mt-0.5 h-3 w-3 shrink-0 rounded-full ring-2 ring-slate-300" style=`background:${s.color}`}></span>
              </div>
              <p class="mt-1 text-[11px] leading-snug text-slate-500">{s.desc}</p>
              <ul class="mt-2 space-y-0.5 text-[11px] text-slate-600">
                <li>Venezuela: {s.venPhases.map(([r, l]) => `${r}% ${l} años`).join(', ')}</li>
                <li>Colombia: {s.colRate}% · volatilidad VEN ±{s.venVol} pp</li>
              </ul>
              <div class="mt-3 rounded-lg bg-slate-100 px-3 py-2 text-xs">
                <span class="text-slate-600">Mediana: </span>
                <span class="years-median font-black text-slate-900" data-for={s.id}>calculando…</span>
                <span class="years-range block text-[10px] text-slate-500" data-for={s.id}></span>
              </div>
            </button>
          ))}
        </div>

        <div class="card mt-4">
          <label for="friction" class="flex flex-wrap items-center justify-between gap-2 text-sm font-bold text-slate-900">
            Fricción institucional
            <span class="badge border-col-amber-soft text-col-amber-deep">resta puntos porcentuales al crecimiento de Venezuela cada año</span>
          </label>
          <input id="friction" type="range" min="0" max="3" step="0.25" value="1" class="mt-4 w-full" />
          <div class="mt-1 flex justify-between text-[10px] text-slate-500"><span>0 pp</span><span>1 pp (valor base del análisis)</span><span>3 pp</span></div>
          <p class="mt-3 text-xs leading-relaxed text-slate-600">
            Representa corrupción, apagones, fuga de capital humano, riesgo político. <span class="font-semibold text-slate-900">Mueve la perilla y compara.</span>
          </p>
        </div>
      </div>

      <div class="card flex flex-col">
        <h3 class="text-sm font-bold text-slate-900">Probabilidad de alcanzar a Colombia en 80 años</h3>
        <p class="mt-1 text-[11px] text-slate-500">Según el escenario seleccionado arriba y la fricción actual.</p>
        <div class="my-6 grid place-items-center">
          <div class="relative h-40 w-40">
            <svg viewBox="0 0 120 120" class="h-full w-full -rotate-90">
              <circle cx="60" cy="60" r="52" fill="none" stroke="#e2e8f0" stroke-width="10" />
              <circle id="probArc" cx="60" cy="60" r="52" fill="none" stroke="#d9a500" stroke-width="10" stroke-linecap="round" stroke-dasharray="326.7" stroke-dashoffset="326.7" class="transition-all duration-500" />
            </svg>
            <div class="absolute inset-0 grid place-content-center text-center">
              <span id="probPct" class="text-4xl font-black text-slate-900">—</span>
              <span class="text-[11px] text-slate-500">de 5.000 simulaciones</span>
            </div>
          </div>
        </div>
        <dl class="mt-auto space-y-1.5 text-xs">
          <div class="flex justify-between border-b border-slate-100 pb-1"><dt class="text-slate-600">Mediana (si llega)</dt><dd id="statMedian" class="font-bold text-slate-900">—</dd></div>
          <div class="flex justify-between border-b border-slate-100 pb-1"><dt class="text-slate-600">Rango P10–P90</dt><dd id="statRange" class="font-bold text-slate-900">—</dd></div>
          <div class="flex justify-between"><dt class="text-slate-600">No llega en 80 años</dt><dd id="statFail" class="font-bold text-col-red">—</dd></div>
        </dl>
        <p class="mt-4 text-[10px] italic leading-snug text-slate-500">Cada movimiento de la perilla corre 5.000 simulaciones nuevas con semilla fresca: los números varían un poco en cada carga (la corrida de referencia del análisis usó 20.000).</p>
      </div>
    </div>
  </Section>

  {/* ===================== PASO 6: TRAYECTORIA ===================== */}
  <Section step="6" id="trayectoria" title="Una trayectoria en detalle (rango P10–P90)">
    <div class="card">
      <div class="mb-4 flex flex-wrap items-center gap-3">
        <label for="pathScenario" class="text-xs font-semibold text-slate-600">Escenario:</label>
        <select id="pathScenario" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-900 outline-none focus:border-col-blue-bright">
          {SCENARIOS.map((s) => <option value={s.id}>{s.name}</option>)}
        </select>
        <span class="text-[11px] text-slate-500">Se comparte la perilla de fricción del Paso 5.</span>
      </div>
      <p class="mb-2 text-xs text-slate-600">Eje vertical: <strong class="text-slate-900">PIB por persona de Venezuela como % del de Colombia</strong>. La banda cubre el 80% central de simulaciones. Cuando llega a 100%, igualó a Colombia.</p>
      <div id="chartWrap" class="w-full overflow-hidden rounded-xl bg-slate-50 ring-1 ring-slate-200">
        <canvas id="bandChart" class="block w-full" height="380"></canvas>
      </div>
      <p id="pathReadout" class="mt-3 text-xs font-medium text-col-blue-bright"></p>
    </div>
  </Section>

  {/* ===================== PASO 7: SENSIBILIDAD ===================== */}
  <Section step="7" id="sensibilidad" title="¿Y si Colombia también crece más? (sensibilidad)">
    <p class="mb-4 max-w-3xl text-sm leading-relaxed text-slate-600">
      Años hasta alcanzar a Colombia, con tasas constantes (brecha 2,4×). <span class="font-semibold text-slate-800">La meta se mueve: cuanto más rápido crece Colombia, más lejos queda.</span>
    </p>
    <div class="grid gap-4 lg:grid-cols-2">
      <div class="card">
        <h3 class="mb-2 text-sm font-bold text-slate-900">Matriz de sensibilidad — sin fricción</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-center text-[11px]" id="heatA"></table>
        </div>
      </div>
      <div class="card">
        <h3 class="mb-2 text-sm font-bold text-slate-900">Matriz de sensibilidad — con 1 pp de fricción</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-center text-[11px]" id="heatB"></table>
        </div>
      </div>
    </div>
    <p class="mt-3 text-[11px] text-slate-500">Lectura: filas = crecimiento constante de Venezuela; columnas = crecimiento constante de Colombia. «∞» = nunca alcanza la brecha de 2,4×.</p>
  </Section>

  {/* ===================== CONCLUSIÓN ===================== */}
  <section id="conclusion" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-12">
    <div class="mb-6 flex items-center gap-3">
      <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-gradient-to-br from-col-amber to-col-blue-bright text-sm font-black text-slate-900">✓</span>
      <h2 class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl">Qué se puede decir con honestidad</h2>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {CONCLUSIONS.map((c, i) => (
        <div class="card flex gap-4">
          <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-col-blue-soft text-sm font-black text-col-blue-bright ring-1 ring-col-blue-soft">{i + 1}</span>
          <p class="text-sm leading-relaxed text-slate-700">{c}</p>
        </div>
      ))}
    </div>
  </section>

  {/* ===================== BOGOTÁ: ESPERAR O NO ===================== */}
  <section id="respuesta" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-12">
    <h2 class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl">Si quieres vivir el bienestar de Bogotá: ¿esperar o no esperar?</h2>
    <div class="mt-6 grid gap-4 lg:grid-cols-2">
      <div class="card">
        <h3 class="text-sm font-bold text-slate-900">Ingreso por persona (lo que sí calcula el modelo)</h3>
        <ul class="mt-3 space-y-3 text-xs leading-relaxed text-slate-700">
          <li class="flex gap-3"><span class="shrink-0 rounded-md bg-col-blue-soft px-2 py-1 font-black text-col-blue-bright">≈28 años</span><span>“Estado 51” hipotético, sin fricción (rango 19–41). Es el caso más rápido del modelo.</span></li>
          <li class="flex gap-3"><span class="shrink-0 rounded-md bg-col-amber-soft px-2 py-1 font-black text-col-amber-deep">≈50 años</span><span>Apertura petrolera, sin fricción (rango 34–73).</span></li>
          <li class="flex gap-3"><span class="shrink-0 rounded-md bg-col-amber-soft px-2 py-1 font-black text-col-amber-deep">≈53 años</span><span>“Estado 51” con 1 pp de fricción (32 a más de 80).</span></li>
          <li class="flex gap-3"><span class="shrink-0 rounded-md bg-col-red-soft px-2 py-1 font-black text-col-red">No llega</span><span>Statu quo y escenario adverso. Con 1 pp de fricción, la apertura petrolera no llega en 80 años en ~87% de las simulaciones.</span></li>
        </ul>
        <p class="mt-3 text-[10px] italic text-slate-500">Corrida de referencia: 20.000 simulaciones; los números varían en cada carga.</p>
      </div>

      <div class="card border-col-blue-soft bg-col-blue-mist">
        <h3 class="text-sm font-bold text-slate-900">Bienestar en todo sentido (servicios, seguridad, instituciones, salud, educación)</h3>
        <p class="mt-3 text-sm leading-relaxed text-slate-700">
          <strong class="text-col-blue-bright">Este modelo no puede calcularlo.</strong> Lectura cualitativa, sin cálculo detrás: va <strong class="text-slate-900">rezagado respecto al ingreso</strong>, porque reconstruir instituciones y capital humano es más lento que recuperar producción.
        </p>
        <div class="mt-4 rounded-xl border border-col-blue-soft bg-slate-50 p-4">
          <p class="text-[11px] font-semibold uppercase tracking-wide text-col-blue-bright">Mejor de los casos para el mismo bienestar social que hoy tiene Bogotá</p>
          <p class="mt-1 text-2xl font-black text-slate-900">Unas 2 generaciones o más <span class="text-base font-bold text-slate-600">(≈40–60 años)</span></p>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">Y en el caso base puede que no ocurra durante la vida laboral de quien decide hoy.</p>
        </div>
      </div>
    </div>

    <div class="card mt-4 border-col-amber-soft bg-col-amber-mist">
      <h3 class="text-sm font-bold text-col-amber-deep">Panorama más claro</h3>
      <p class="mt-2 text-sm leading-relaxed text-slate-700">
        Para una persona que quiere ese nivel de vida durante su vida laboral, <strong class="text-slate-900">el modelo no respalda planificar en torno a una espera</strong>.
        Incluso en el escenario más rápido (hipotético y no verificable), la convergencia de ingreso toma unos 30 años.
        Esperar no es una estrategia con respaldo en estos números. Ni siquiera es una cuestión de “cuántos años”, sino de <strong class="text-slate-900">si ocurre</strong>.
      </p>
    </div>

    <div class="mt-4 grid gap-4 lg:grid-cols-2">
      <div class="card">
        <h3 class="mb-3 text-sm font-bold text-slate-900">Matices que sí importan</h3>
        <ol class="list-decimal space-y-2 pl-5 text-xs leading-relaxed text-slate-600 marker:font-bold marker:text-col-blue-bright">
          {NUANCES.map((n) => <li>{n}</li>)}
        </ol>
      </div>
      <div class="card">
        <h3 class="mb-3 text-sm font-bold text-slate-900">Limitaciones</h3>
        <ul class="list-disc space-y-2 pl-5 text-xs leading-relaxed text-slate-600 marker:text-col-red">
          {LIMITATIONS.map((l) => <li>{l}</li>)}
        </ul>
      </div>
    </div>

    {/* Acordeón USWDS para las preguntas frecuentes */}
    <div class="usa-accordion usa-accordion--multiselectable margin-top-4" id="faq-acc" data-allow-multiple>
      <h3 class="font-body-sm text-slate-900 font-bold margin-bottom-2">Preguntas frecuentes del modelo</h3>
      {FAQ.map((f, i) => (
        <>
          <button type="button" class="usa-accordion__button" aria-expanded={(i === 0)} aria-controls={`faq-${i}`}>
            <span>{f.q}</span>
          </button>
          <div id={`faq-${i}`} class="usa-accordion__content usa-prose"{hidden={i !== 0}}>
            <p class="text-xs leading-relaxed text-slate-600">{f.a}</p>
          </div>
        </>
      ))}
    </div>

    <p class="mt-6 text-[11px] leading-relaxed text-slate-500"><strong class="text-slate-600">Fuentes:</strong> {SOURCES}</p>
  </section>
</Layout>

<script>
  import { SCENARIOS } from '../data/data.js';
  import { runScenario, runPaths, analyticCatchUp, N_SIMS, MAX_YEARS } from '../lib/sim.js';

  const frictionEl = document.getElementById('friction');
  const pathSel = document.getElementById('pathScenario');
  let selected = 'B';
  let seedCounter = 0; // cada interacción corre una simulación nueva (como en el análisis: varía por carga)

  const $ = (id) => document.getElementById(id);

  function scenarioById(id) { return SCENARIOS.find((s) => s.id === id); }

  // ---- Tabla resumen de escenarios (Paso 5) ----
  function renderSummary() {
    const f = parseFloat(frictionEl.value);
    seedCounter++;
    const seed = 12345 + seedCounter * 7919;
    for (const s of SCENARIOS) {
      const r = runScenario(s, f, N_SIMS, seed);
      const med = document.querySelector(`.years-median[data-for="${s.id}"]`);
      const rng = document.querySelector(`.years-range[data-for="${s.id}"]`);
      if (r.median === null) {
        med.textContent = 'No llega en 80 años';
        med.classList.remove('text-slate-900'); med.classList.add('text-col-red');
        rng.textContent = `solo ${(r.reachPct * 100).toFixed(0)}% de las trayectorias converge`;
      } else {
        med.textContent = `≈ ${r.median} años`;
        med.classList.remove('text-col-red'); med.classList.add('text-slate-900');
        rng.textContent = `P10–P90: ${r.p10}–${r.p90} años · llega en ${(r.reachPct * 100).toFixed(0)}% de los casos`;
      }
    }
    renderDetail();
  }

  // ---- Panel circular del escenario seleccionado ----
  function renderDetail() {
    const f = parseFloat(frictionEl.value);
    const s = scenarioById(selected);
    const r = runScenario(s, f, N_SIMS, 12345 + seedCounter * 7919);
    const arc = $('probArc'), pct = $('probPct');
    const CIRC = 2 * Math.PI * 52;
    arc.style.strokeDashoffset = String(CIRC * (1 - r.reachPct));
    arc.setAttribute('stroke', s.color);
    pct.textContent = `${Math.round(r.reachPct * 100)}%`;
    $('statMedian').textContent = r.median === null ? 'No llega' : `≈ ${r.median} años`;
    $('statRange').textContent = r.median === null ? '—' : `${r.p10} – ${r.p90} años`;
    $('statFail').textContent = `${Math.round((1 - r.reachPct) * 100)}% de las trayectorias`;
    drawBand();
  }

  // ---- Gráfico de banda P10-P90 (canvas) ----
  function drawBand() {
    const canvas = $('bandChart');
    const wrap = $('chartWrap');
    const dpr = window.devicePixelRatio || 1;
    const W = wrap.clientWidth, H = 380;
    canvas.width = W * dpr; canvas.height = H * dpr;
    canvas.style.height = H + 'px';
    const ctx = canvas.getContext('2d');
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);

    const f = parseFloat(frictionEl.value);
    const s = scenarioById(pathSel.value);
    // Semilla distinta por escenario/friccion/corrida para que la banda se recalcule cada vez.
    const bseed = 777 + s.id.charCodeAt(0) * 97 + Math.round(f * 100) * 31 + seedCounter * 7919;
    const paths = runPaths(s, f, 400, MAX_YEARS, bseed);
    const padL = 46, padR = 14, padT = 14, padB = 30;
    const iw = W - padL - padR, ih = H - padT - padB;
    const maxY = 120; // % del PIB de Colombia
    const x = (yr) => padL + (yr / MAX_YEARS) * iw;
    const y = (v) => padT + ih - (Math.min(v, maxY) / maxY) * ih;

    // rejilla
    ctx.strokeStyle = 'rgba(15,23,42,.07)';
    ctx.fillStyle = 'rgba(100,116,139,.9)';
    ctx.font = '10px ui-sans-serif, system-ui';
    for (let v = 0; v <= maxY; v += 20) {
      ctx.beginPath(); ctx.moveTo(padL, y(v)); ctx.lineTo(W - padR, y(v)); ctx.stroke();
      ctx.fillText(`${v}%`, 8, y(v) + 3);
    }
    for (let yr = 0; yr <= MAX_YEARS; yr += 10) {
      ctx.beginPath(); ctx.moveTo(x(yr), padT); ctx.lineTo(x(yr), padT + ih); ctx.stroke();
      ctx.fillText(`${yr}`, x(yr) - 6, H - 12);
    }
    // línea 100%
    ctx.strokeStyle = 'rgba(0,56,168,.55)';
    ctx.setLineDash([5, 4]);
    ctx.beginPath(); ctx.moveTo(padL, y(100)); ctx.lineTo(W - padR, y(100)); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = 'rgba(0,56,168,.9)';
    ctx.fillText('Igualdad con Colombia (100%)', padL + 6, y(100) - 5);

    // banda P10-P90
    ctx.beginPath();
    paths.forEach((p, i) => { const px = x(i), py = y(p.p90 * 100); i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py); });
    for (let i = paths.length - 1; i >= 0; i--) ctx.lineTo(x(i), y(paths[i].p10 * 100));
    ctx.closePath();
    ctx.fillStyle = s.color + '2e';
    ctx.fill();

    // percentiles
    const line = (key, width, alpha) => {
      ctx.beginPath();
      paths.forEach((p, i) => { const px = x(i), py = y(p[key] * 100); i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py); });
      ctx.strokeStyle = s.color + alpha; ctx.lineWidth = width; ctx.stroke();
    };
    line('p10', 1.2, 'cc'); line('p90', 1.2, 'cc'); line('p50', 2.4, '');

    // marca de cruce de la mediana
    const cross = paths.findIndex((p) => p.p50 >= 1);
    const readout = $('pathReadout');
    if (cross > 0) {
      ctx.beginPath(); ctx.arc(x(cross), y(100), 4.5, 0, 2 * Math.PI);
      ctx.fillStyle = '#fff'; ctx.fill();
      ctx.strokeStyle = s.color; ctx.lineWidth = 2; ctx.stroke();
      readout.textContent = `La trayectoria mediana iguala a Colombia hacia el año ${cross} (≈ ${2026 + cross}). La banda muestra el rango P10–P90.`;
    } else {
      readout.textContent = 'Con estos supuestos, ni la trayectoria mediana alcanza el 100% dentro del horizonte de 80 años.';
    }
  }

  // ---- Mapas de calor de sensibilidad (Paso 7) ----
  function buildHeat(elId, friction) {
    const gVens = [2, 3, 4, 5, 6, 7, 8, 9];
    const gCols = [1.5, 2, 2.5, 3, 3.5, 4];
    const vals = gVens.map((gv) => gCols.map((gc) => analyticCatchUp(gv, gc, friction)));
    const flat = vals.flat().filter((v) => v !== null);
    const mn = Math.min(...flat), mx = Math.max(...flat);
    const color = (v) => {
      if (v === null) return ['#f1f5f9', '#94a3b8'];
      const t = (v - mn) / (mx - mn || 1);
      const hue = 160 - t * 160; // verde -> rojo
      return [`hsl(${hue} 70% 92%)`, `hsl(${hue} 75% 28%)`];
    };
    let html = `<thead><tr><th class="p-1.5 text-slate-600">VEN ↓ / COL →</th>${gCols.map((c) => `<th class="p-1.5 font-bold text-col-blue-bright">${c}%</th>`).join('')}</tr></thead><tbody>`;
    vals.forEach((row, i) => {
      html += `<tr><td class="p-1.5 text-left font-bold text-col-amber-deep">${gVens[i]}%</td>`;
      row.forEach((v) => {
        const [bg, fg] = color(v);
        html += `<td class="rounded m-0.5 p-1.5 font-bold" style="background:${bg};color:${fg}">${v === null ? '∞' : v}</td>`;
      });
      html += '</tr>';
    });
    html += '</tbody>';
    document.getElementById(elId).innerHTML = html;
  }

  // ---- Eventos ----
  document.querySelectorAll('.scenario-card').forEach((btn) => {
    btn.addEventListener('click', () => {
      selected = btn.dataset.scenario;
      pathSel.value = selected;
      paintCards();
      renderDetail();
    });
  });
  function paintCards() {
    document.querySelectorAll('.scenario-card').forEach((b) => {
      b.classList.toggle('ring-2', b.dataset.scenario === selected);
      b.classList.toggle('ring-col-blue', b.dataset.scenario === selected);
    });
  }
  frictionEl.addEventListener('input', renderSummary);
  pathSel.addEventListener('change', renderDetail);
  window.addEventListener('resize', drawBand);

  buildHeat('heatA', 0);
  buildHeat('heatB', 1);
  paintCards();
  renderSummary();
</script>
