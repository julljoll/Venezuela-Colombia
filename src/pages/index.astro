---
import Layout from '../layouts/Layout.astro';
import Roadmap from '../components/Roadmap.astro';
import { META, PHASES, STEPS, SYLLABUS, RISKS, FAQ, SOURCES, TIMELINE } from '../data/roadmap.js';

const colorDot = {
  sky: 'bg-sky-400',
  violet: 'bg-violet-400',
  emerald: 'bg-emerald-400',
  amber: 'bg-amber-400',
  rose: 'bg-rose-400',
};
const totalTasks = STEPS.reduce((acc, s) => acc + s.tasks.length, 0);
---

<Layout>
  {/* ===================== HERO ===================== */}
  <section id="inicio" class="relative overflow-hidden">
    <div class="mx-auto max-w-6xl px-4 pb-14 pt-16 text-center sm:pt-24">
      <span class="badge mb-4">Guía paso a paso · UNELLEZ → Colombia · Actualizada al {META.updated}</span>
      <h1 class="mx-auto max-w-4xl text-3xl font-black leading-tight tracking-tight text-white sm:text-5xl">
        Tu título de Abogado(a) de la{' '}
        <span class="bg-gradient-to-r from-teal-300 to-amber-300 bg-clip-text text-transparent">UNELLEZ</span>,
        convalidado y habilitado para ejercer en{' '}
        <span class="bg-gradient-to-r from-amber-300 to-teal-300 bg-clip-text text-transparent">Colombia</span>
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-sm leading-relaxed text-slate-400 sm:text-base">
        Ruta clara de {STEPS.length} pasos agrupados en 4 fases más un eje migratorio transversal, construida alrededor del
        <span class="font-semibold text-white"> {META.program.name} </span>
        de {META.program.institution}, como estudio de complementación para solicitar la convalidación ante el Ministerio de Educación Nacional.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="#ruta" class="rounded-xl bg-gradient-to-r from-teal-400 to-amber-400 px-5 py-3 text-sm font-bold text-slate-900 shadow-lg shadow-teal-500/20 transition hover:brightness-110">
          Ver la hoja de ruta completa
        </a>
        <a href={META.program.url} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-white/15 bg-white/5 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10">
          Ficha oficial del programa UTadeo ↗
        </a>
      </div>

      {/* Tarjetas resumen */}
      <div class="mt-10 grid gap-3 sm:grid-cols-3">
        <div class="card !p-5 text-left">
          <p class="text-xs uppercase tracking-wider text-slate-500">Duración estimada total</p>
          <p class="mt-1 text-2xl font-black text-white">9 – 20 meses</p>
          <p class="mt-1 text-xs text-slate-400">Sin rechazos ni requerimientos adicionales.</p>
        </div>
        <div class="card !p-5 text-left">
          <p class="text-xs uppercase tracking-wider text-slate-500">Meta final</p>
          <p class="mt-1 text-2xl font-black text-white">Tarjeta Profesional</p>
          <p class="mt-1 text-xs text-slate-400">Expedida por el Consejo Superior de la Judicatura.</p>
        </div>
        <div class="card !p-5 text-left">
          <p class="text-xs uppercase tracking-wider text-slate-500">Checklist</p>
          <p class="mt-1 text-2xl font-black text-white">{totalTasks} tareas</p>
          <p class="mt-1 text-xs text-slate-400">Marca tu avance; se guarda en este navegador.</p>
        </div>
      </div>

      {/* Barra de progreso global */}
      <div class="card mx-auto mt-6 max-w-3xl text-left">
        <div class="mb-2 flex items-center justify-between gap-3">
          <p class="text-sm font-bold text-white">Tu progreso en la ruta</p>
          <span id="progress-label" class="badge">0/{totalTasks} tareas · 0%</span>
        </div>
        <div class="progress-track"><div id="progress-bar" class="progress-fill"></div></div>
        <button id="reset-progress" type="button" class="mt-3 text-xs font-semibold text-slate-500 underline-offset-2 transition hover:text-rose-300 hover:underline">
          Reiniciar mi progreso
        </button>
      </div>

      <div class="card mx-auto mt-6 max-w-3xl border-amber-400/20 bg-amber-400/[0.05] text-left">
        <p class="text-sm leading-relaxed text-slate-300">
          <span class="font-bold text-amber-300">Aviso importante:</span> esta guía organiza el camino conocido, pero no sustituye la información oficial.
          Antes de pagar cualquier trámite, confirma requisitos, tarifas y plazos en el Ministerio de Educación Nacional, la UTadeo,
          el Consejo Superior de la Judicatura y Migración Colombia. Las normas cambian con frecuencia.
        </p>
      </div>
    </div>
  </section>

  {/* ===================== FASES ===================== */}
  <section id="fases" class="mx-auto max-w-6xl scroll-mt-24 px-4 pt-12">
    <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">Las 4 fases + el eje migratorio</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-slate-400">Cada fase tiene entregables concretos. No saltes a la siguiente sin cerrar los pendientes de la anterior.</p>
    <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-5">
      {PHASES.map((p) => (
        <article class="card !p-5">
          <span class={`mb-3 inline-block h-2.5 w-2.5 rounded-full ${colorDot[p.color]}`}></span>
          <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500">{p.short} · {p.duration}</p>
          <h3 class="mt-1 text-sm font-bold leading-snug text-white">{p.title}</h3>
          <p class="mt-2 text-xs leading-relaxed text-slate-400">{p.goal}</p>
        </article>
      ))}
    </div>
  </section>

  {/* ===================== HOJA DE RUTA ===================== */}
  <section id="ruta" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-12">
    <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">Hoja de ruta paso a paso</h2>
    <p class="mb-8 mt-2 max-w-3xl text-sm leading-relaxed text-slate-400">
      Despliega cada paso para ver el detalle, la lista de tareas marcables y el tip práctico. Haz clic en el número o en el título.
    </p>
    <Roadmap />
  </section>

  {/* ===================== PROGRAMA UTADEO ===================== */}
  <section id="programa" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-12">
    <div class="mb-6 flex items-center gap-3">
      <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-gradient-to-br from-violet-400/25 to-fuchsia-400/25 text-sm font-black text-violet-300 ring-1 ring-white/10">★</span>
      <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">El puente académico: Programa de Actualización en Derecho Colombiano</h2>
    </div>
    <div class="grid gap-4 lg:grid-cols-3">
      <div class="card lg:col-span-2">
        <p class="text-sm leading-relaxed text-slate-300">{META.program.role}</p>
        <p class="mt-3 text-sm leading-relaxed text-slate-400">
          Al culminar la carrera de Derecho en la {META.school}, tu formación está anclada en el ordenamiento jurídico venezolano.
          Para que el MEN colombiano pueda declarar la equivalencia de tu título, necesitas demostrar que conoces las instituciones
          jurídicas del país donde vas a ejercer. Ese es exactamente el papel de este programa: nivelar el currículo y entregar un
          certificado que acompañe tu solicitud de convalidación.
        </p>
        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          {SYLLABUS.map((s) => (
            <div class="rounded-xl border border-white/8 bg-white/[0.03] p-4">
              <p class="text-xs font-bold uppercase tracking-wider text-violet-300">{s.area}</p>
              <ul class="mt-2 space-y-1.5">
                {s.items.map((i) => (
                  <li class="flex gap-2 text-xs leading-relaxed text-slate-300">
                    <span class="text-violet-400">•</span><span>{i}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="mt-4 text-[11px] italic leading-relaxed text-slate-500">
          Temas ilustrativos de un programa de actualización en derecho colombiano. Confirma el contenido exacto, intensidad horaria y modalidad en la ficha oficial de la UTadeo.
        </p>
      </div>
      <aside class="card border-violet-400/20 bg-violet-500/[0.06]">
        <p class="text-xs font-bold uppercase tracking-wider text-violet-300">Ficha del programa</p>
        <h3 class="mt-2 text-base font-bold leading-snug text-white">{META.program.name}</h3>
        <p class="mt-1 text-xs text-slate-400">{META.program.institution}</p>
        <dl class="mt-4 space-y-3 text-xs">
          <div><dt class="font-semibold text-slate-300">Modalidad</dt><dd class="text-slate-400">Educación continua / no formal (verifica presencial o virtual).</dd></div>
          <div><dt class="font-semibold text-slate-300">Duración típica</dt><dd class="text-slate-400">4 – 8 meses según calendario de admisiones.</dd></div>
          <div><dt class="font-semibold text-slate-300">Entregable clave</dt><dd class="text-slate-400">Certificado de aprobación con horas y asignaturas.</dd></div>
          <div><dt class="font-semibold text-slate-300">Para qué sirve</dt><dd class="text-slate-400">Sustentar la convalidación ante el MEN.</dd></div>
        </dl>
        <a href={META.program.url} target="_blank" rel="noopener noreferrer"
           class="mt-5 block rounded-xl bg-gradient-to-r from-violet-400 to-fuchsia-400 px-4 py-3 text-center text-sm font-bold text-slate-900 transition hover:brightness-110">
          Inscribirme / ver requisitos ↗
        </a>
      </aside>
    </div>
  </section>

  {/* ===================== CRONOGRAMA ===================== */}
  <section id="cronograma" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-12">
    <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">Cronograma referencial</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-slate-400">Meses corridos desde el inicio del expediente. Es una estimación, no un compromiso de plazos.</p>
    <ol class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {TIMELINE.map((t, i) => (
        <li class="card !p-4">
          <p class="text-[11px] font-black uppercase tracking-widest text-teal-300">{t.month}</p>
          <p class="mt-1 text-sm font-semibold leading-snug text-white">{t.label}</p>
          <div class="mt-3 h-1.5 rounded-full bg-white/8">
            <div class="h-full rounded-full bg-gradient-to-r from-teal-400 to-amber-400" style={`width:${Math.round(((i + 1) / TIMELINE.length) * 100)}%`}></div>
          </div>
        </li>
      ))}
    </ol>
  </section>

  {/* ===================== RIESGOS ===================== */}
  <section id="riesgos" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-12">
    <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">Riesgos que retrasan el trámite (y cómo evitarlos)</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {RISKS.map((r) => (
        <article class="card border-rose-400/15 !p-5">
          <p class="text-sm font-bold text-rose-300">{r.risk}</p>
          <p class="mt-2 text-xs text-slate-400"><span class="font-semibold text-slate-300">Consecuencia:</span> {r.impact}</p>
          <p class="mt-2 text-xs text-teal-200"><span class="font-semibold text-teal-300">Cómo evitarlo:</span> {r.mitigation}</p>
        </article>
      ))}
    </div>
  </section>

  {/* ===================== FAQ ===================== */}
  <section id="faq" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-12">
    <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">Preguntas frecuentes</h2>
    <div class="mt-6 grid gap-3">
      {FAQ.map((f) => (
        <details class="card group !p-0">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5">
            <span class="text-sm font-bold text-white">{f.q}</span>
            <span class="faq-icon grid h-7 w-7 shrink-0 place-items-center rounded-full bg-white/5 text-lg text-teal-300 ring-1 ring-white/10">+</span>
          </summary>
          <p class="border-t border-white/8 px-5 py-4 text-sm leading-relaxed text-slate-300">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  {/* ===================== FUENTES ===================== */}
  <section id="fuentes" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-12">
    <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">Fuentes oficiales para verificar cada paso</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-slate-400">Consulta siempre el sitio oficial antes de radicar o pagar.</p>
    <ul class="mt-6 grid gap-3 md:grid-cols-2">
      {SOURCES.map((s) => (
        <li class="card !p-5">
          <a href={s.href} target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-teal-300 underline-offset-2 hover:underline">
            {s.label} ↗
          </a>
          <p class="mt-1 text-xs leading-relaxed text-slate-400">{s.note}</p>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style is:global>
  @import '../styles/global.css';
</style>
