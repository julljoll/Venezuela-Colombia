---
import { META } from '../data/roadmap.js';

const nav = [
  { href: '#ruta', label: 'Hoja de ruta' },
  { href: '#programa', label: 'Programa UTadeo' },
  { href: '#cronograma', label: 'Cronograma' },
  { href: '#riesgos', label: 'Riesgos' },
  { href: '#faq', label: 'Preguntas' },
  { href: '#fuentes', label: 'Fuentes' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{META.title} · UNELLEZ → Colombia</title>
    <meta name="description" content="Hoja de ruta paso a paso para convalidar el título de Abogado venezolano (UNELLEZ) en Colombia mediante el Programa de Actualización en Derecho Colombiano de la UTadeo y obtener la Tarjeta Profesional." />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚖️</text></svg>" />
  </head>
  <body class="min-h-screen text-slate-200 antialiased selection:bg-teal-400/30">
    <header class="sticky top-0 z-40 border-b border-white/10 bg-[#0b1220]/85 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
        <a href="#inicio" class="flex items-center gap-2 text-sm font-bold tracking-tight text-white">
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-teal-400 to-amber-400 text-base">⚖️</span>
          <span class="hidden sm:inline">Convalidación UNELLEZ · Colombia</span>
        </a>
        <nav class="hidden items-center gap-0.5 text-xs font-medium text-slate-400 xl:flex">
          {nav.map((n) => <a href={n.href} class="rounded-md px-2 py-1.5 transition hover:bg-white/5 hover:text-white">{n.label}</a>)}
        </nav>
        <a href={META.program.url} target="_blank" rel="noopener noreferrer" class="badge whitespace-nowrap ring-teal-400/30 hover:text-teal-200">Programa UTadeo ↗</a>
      </div>
    </header>

    <slot />

    <footer class="mt-16 border-t border-white/10 py-8 text-center text-xs leading-relaxed text-slate-500">
      <p class="mx-auto max-w-3xl px-4">
        Guía informativa independiente sobre convalidación de títulos extranjeros en Colombia. No es asesoría legal ni una promesa de resultado:
        los requisitos, plazos y tarifas cambian. Verifica siempre en las fuentes oficiales del Ministerio de Educación Nacional,
        el Consejo Superior de la Judicatura, Migración Colombia y la Universidad de Tadéo Lozano.
      </p>
      <p class="mt-3">Actualizado: {META.updated}</p>
    </footer>
  </body>
</html>
